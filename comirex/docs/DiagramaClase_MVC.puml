@startuml DiagramaClase_MVC
title Diagrama de clase – Formular Recepție Document Însoțitor\nȘablon MVC adaptat

skinparam classBackgroundColor #EFF5FF
skinparam classBorderColor #1F6FEB
skinparam classHeaderBackgroundColor #1F6FEB
skinparam classHeaderFontColor #FFFFFF
skinparam arrowColor #1F6FEB
skinparam packageBackgroundColor #F8FAFF
skinparam packageBorderColor #C4CEDB
skinparam linetype ortho

' =====================================================================
' LAYER 1 — ENTITY
' =====================================================================
package "Entity" #F0F4FF {

    abstract class AbstractEntity {
        - id : Long
        - version : Integer
        - dateCreated : Date
        - dateUpdated : Date
        + getId() : Long
        + getVersion() : Integer
    }

    abstract class Document {
        - tipDocument : String
        - numarDocument : String
        - dataDocument : Date
        - dataOperare : Date
        + getTipDocument() : String
        + setTipDocument(tip : String)
        + getNumarDocument() : String
        + setNumarDocument(nr : String)
    }

    class DocInsotitor {
        - codDocInsot : String
        - mijlocTransport : String
        + addReceptie(r : Receptie)
        + removeReceptie(r : Receptie)
        + getReceptii() : List<Receptie>
        + getFurnizor() : Furnizor
        + setFurnizor(f : Furnizor)
        + setDocInsotitorReferinta(d : DocInsotitor)
    }

    class Receptie {
        - nrNIR : String
        - codNIR : String
        - dataReceptie : Date
        - facturaPrimita : Integer
        + addLinieIntrare(l : LinieIntrare)
        + removeLinieIntrare(l : LinieIntrare)
        + getLiniiIntrare() : List<LinieIntrare>
        + getGestiune() : Gestiune
        + setGestiune(g : Gestiune)
        + getNrNIR() : String
        + setNrNIR(nr : String)
    }

    class LinieIntrare {
        - cantitate : Double
        - pretAchizitie : Double
        - pretVanzare : Double
        - adaos : Double
        + getCantitate() : Double
        + setCantitate(c : Double)
        + getProdus() : Produs
        + setProdus(p : Produs)
        + getPretAchizitie() : Double
        + setPretAchizitie(p : Double)
    }

    class Furnizor {
        - codFurnizor : String
        - numeFurnizor : String
        - cui : String
        - adresa : String
        - sold : Double
        + getNumeFurnizor() : String
        + getCodFurnizor() : String
        + getCui() : String
    }

    class Gestiune {
        - codGestiune : String
        - denumireGestiune : String
        - numeGestionar : String
        - adresa : String
        + getDenumireGestiune() : String
        + getNumeGestionar() : String
    }

    class Produs {
        - codProdus : String
        - denumire : String
        - um : String
        - pretVanzare : Double
        - costMediuPonderat : Double
        + getCodProdus() : String
        + getDenumire() : String
        + getUm() : String
        + getCostMediuPonderat() : Double
    }

    class Stoc {
        - stocCurent : Double
        - stocInitialLuna : Double
        - stocInitialAn : Double
        + getStocCurent() : Double
        + setStocCurent(s : Double)
        + getProdus() : Produs
        + setProdus(p : Produs)
        + getGestiune() : Gestiune
        + setGestiune(g : Gestiune)
    }
}

' =====================================================================
' LAYER 2 — REPOSITORY
' =====================================================================
package "Repository" #FFF8F0 {

    abstract class AbstractRepository {
        # create(entity : Object) : Object
        # update(entity : Object) : Object
        # delete(entity : Object)
        # getEm() : EntityManager
        + beginTransaction()
        + commitTransaction()
    }

    class MasterRepository {
        + findFurnizoriAll() : List<Furnizor>
        + findFurnizorById(id : Long) : Furnizor
        + addFurnizor(f : Furnizor) : Furnizor
        + findGestiuniAll() : List<Gestiune>
        + addGestiune(g : Gestiune) : Gestiune
        + findProduseAll() : List<Produs>
        + addProdus(p : Produs) : Produs
        + findStocByProdusGestiune(pid : Long, gid : Long) : List<Stoc>
        + addStoc(s : Stoc) : Stoc
        + updateStoc(s : Stoc) : Stoc
    }

    class DocumentRepository {
        + saveDocInsotitor(d : DocInsotitor) : DocInsotitor
        + findDocInsotitoriAll() : List<DocInsotitor>
        + saveReceptie(r : Receptie) : Receptie
        + findReceptiiAll() : List<Receptie>
    }
}

' =====================================================================
' LAYER 3 — MODEL (FormData)
' =====================================================================
package "Model" #F0FFF4 {

    class ReceptieFormData {
        - documentCurent : DocInsotitor
        - receptieSelectata : Receptie
        - operatieSelectata : String
        - listaFurnizori : List<Furnizor>
        - listaGestiuni : List<Gestiune>
        - listaProduse : List<Produs>
        {static} RECEPTIE_CU_FACTURA : String
        {static} RECEPTIE_CU_AVIZ : String
        {static} STORNARE : String
        + getDocumentCurent() : DocInsotitor
        + setDocumentCurent(d : DocInsotitor)
        + getReceptieSelectata() : Receptie
        + setReceptieSelectata(r : Receptie)
        + getListaFurnizori() : List<Furnizor>
        + getListaGestiuni() : List<Gestiune>
        + getListaProduse() : List<Produs>
        + setFurnizorSelectat(f : Furnizor)
        + getOperatieSelectata() : String
        + setOperatieSelectata(op : String)
        + getMasterRepo() : MasterRepository
        + getDocRepo() : DocumentRepository
    }
}

' =====================================================================
' LAYER 4 — CONTROLLER
' =====================================================================
package "Controller" #FFFDF0 {

    class ReceptieFormCtrl {
        - formData : ReceptieFormData
        {static} FACTURA : String
        {static} AVIZ : String
        {static} STORNARE : String
        + documentNou()
        + selectieFurnizor(f : Furnizor)
        + adaugaReceptie()
        + adaugaLinieIntrare()
        + salveazaModificariDocument()
        + initiazaStornareDocument(docOriginal : DocInsotitor)
        - actualizeazaStoc(doc : DocInsotitor)
        + getFormData() : ReceptieFormData
    }
}

' =====================================================================
' LAYER 5 — VIEW
' =====================================================================
package "View" #FFF0F0 {

    class ReceptieFormView {
        - ctrl : ReceptieFormCtrl
        - tableModel : LinieIntrareTableModel
        - cmbTipDocument : JComboBox
        - cmbFurnizor : JComboBox
        - cmbGestiune : JComboBox
        - txtNrDocument : JTextField
        - txtNrReceptie : JTextField
        - tabelLinii : JTable
        + ReceptieFormView()
        - buildNav() : JPanel
        - buildDateRec() : JPanel
        - buildDocRef() : JPanel
        - buildTabel() : JPanel
        - buildSud() : JPanel
        - populeaza()
        - nav(directie : int)
        - adaugRand()
        - stergRand(row : int)
        - salveaza()
        - selecteazaDocumentDeStornat()
        - liveSearch()
        - calc()
        - esteStornare() : boolean
        {static} main(args : String[])
    }

    class LinieIntrareTableModel {
        + getRowCount() : int
        + getColumnCount() : int
        + getColumnName(col : int) : String
        + getValueAt(row : int, col : int) : Object
        + setValueAt(val : Object, row : int, col : int)
        + isCellEditable(row : int, col : int) : boolean
    }
}

' =====================================================================
' RELATII — Entity
' =====================================================================
AbstractEntity <|-- Document
Document       <|-- DocInsotitor

AbstractEntity <|-- Receptie
AbstractEntity <|-- LinieIntrare
AbstractEntity <|-- Furnizor
AbstractEntity <|-- Gestiune
AbstractEntity <|-- Produs
AbstractEntity <|-- Stoc

DocInsotitor "1" o-- "0..*" Receptie        : receptii
DocInsotitor "*" --> "1"    Furnizor         : furnizor
DocInsotitor "*" --> "0..1" DocInsotitor     : docInsotitorReferinta
Receptie     "1" o-- "0..*" LinieIntrare     : liniiIntrare
Receptie     "*" --> "1"    Gestiune         : gestiune
LinieIntrare "*" --> "1"    Produs           : produs
Stoc         "*" --> "1"    Produs           : produs
Stoc         "*" --> "1"    Gestiune         : gestiune

' =====================================================================
' RELATII — Repository
' =====================================================================
AbstractRepository <|-- MasterRepository
AbstractRepository <|-- DocumentRepository

MasterRepository   ..> Furnizor    : gestioneaza
MasterRepository   ..> Gestiune    : gestioneaza
MasterRepository   ..> Produs      : gestioneaza
MasterRepository   ..> Stoc        : gestioneaza
DocumentRepository ..> DocInsotitor : gestioneaza
DocumentRepository ..> Receptie     : gestioneaza

' =====================================================================
' RELATII — MVC
' =====================================================================
ReceptieFormView  --> ReceptieFormCtrl    : ctrl
ReceptieFormCtrl  --> ReceptieFormData   : formData
ReceptieFormData  --> MasterRepository   : masterRepo
ReceptieFormData  --> DocumentRepository : docRepo
ReceptieFormView  +-- LinieIntrareTableModel

@enduml
